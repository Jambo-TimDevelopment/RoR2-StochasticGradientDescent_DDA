<!--
  Copy this file to `TelemetrySecrets.props` (same folder) and fill values.
  `TelemetrySecrets.props` is ignored by git and will NOT be committed.

  For PostHog Cloud (US): Host=https://us.i.posthog.com
  For PostHog Cloud (EU): Host=https://eu.i.posthog.com

  ProjectToken is the "Project token" (write-only ingestion key).
-->
<Project>
  <PropertyGroup>
    <TelemetryPostHogHost>https://us.i.posthog.com</TelemetryPostHogHost>
    <TelemetryPostHogProjectToken></TelemetryPostHogProjectToken>
  </PropertyGroup>
</Project>

